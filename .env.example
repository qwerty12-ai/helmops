# All optional. Works with zero LLM (rule-based parsing).
HELM_HEADED=1            # show the browser (use for the demo video)
HELM_SLOW_MO=350         # ms delay between browser actions (demo only)
HELM_CHANNEL=            # msedge or chrome: use an installed browser if bundled Chromium won't open (Windows)
DEFAULT_AUTHORITY=2000   # USD the operator may enter without asking
# Optional free local LLM via Ollama (ollama pull qwen2.5:3b)
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
